ANTHROPIC_API_KEY=sk-ant-...

# Where the existing Claude Code task log lives. Override only if you moved it.
TASK_LOG_PATH=~/.claude/task-log/log.jsonl

# SQLite by default. Set to a postgres URL for shared deployments.
DATABASE_URL=sqlite:///dashboard.db

# Models
EXTRACTION_MODEL=claude-sonnet-4-6
MATCHER_MODEL=claude-haiku-4-5-20251001

# Auto-match confidence threshold (0-1). Above this, log entries auto-close tasks.
MATCH_THRESHOLD=0.72
